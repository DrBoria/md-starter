{
  "extends": "@md/tsconfig/react.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@md/components/*": [
        "./*"
      ],
      "@md/styles/*": [
        "../styles/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "images.d.ts",
    "styled.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
