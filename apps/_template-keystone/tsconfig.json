{
  "extends": "@md/tsconfig/next.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@_app_original": [
        ".keystone/admin/pages/_app_original"
      ],
      "@md/sections/*": [
        "../../packages/sections/*"
      ],
      "@md/components/*": [
        "../../packages/components/*"
      ],
      "@md/styles/*": [
        "../../packages/styles/*"
      ],
      "@md/api/*": [
        "../../packages/api/*"
      ],
      "@md/utils/*": [
        "../../packages/utils/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "styled.d.ts",
    "images.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
