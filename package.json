{
  "name": "md-starter",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo start",
    "prod": "turbo prod",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@md/stylelint-config": "workspace:*",
    "@md/tsconfig": "workspace:*",
    "postcss-styled-syntax": "^0.7.1",
    "prettier": "^3.3.3",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.10.11",
    "stylelint-order": "^7.0.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.8.1",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@8.15.6",
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.11",
      "@types/react-dom": "^18.3.0"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
